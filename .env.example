# Copy this file to .env and fill in real values. Never commit .env itself.

# --- LLM provider ---
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Database ---
DATABASE_URL=postgresql://copilot:copilot_dev_password@localhost:5432/copilot

# --- Cache / checkpointer ---
REDIS_URL=redis://localhost:6379/0

# --- Observability ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-ai-copilot

# --- n8n ---
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook

# --- Model tiering (Section 5 of the project overview) ---
SUPERVISOR_MODEL=claude-sonnet-4-6
WORKER_MODEL=claude-haiku-4-5-20251001
